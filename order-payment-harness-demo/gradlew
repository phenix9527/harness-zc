#!/usr/bin/env sh

set -e

GRADLE_VERSION=8.10.2
BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_HOME="$BASE_DIR/.gradle/wrapper/dists/gradle-$GRADLE_VERSION-bin/gradle-$GRADLE_VERSION"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"
GRADLE_ZIP="$BASE_DIR/.gradle/wrapper/dists/gradle-$GRADLE_VERSION-bin.zip"
GRADLE_URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"

if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$BASE_DIR/.gradle/wrapper/dists"
  if command -v curl >/dev/null 2>&1; then
    curl -L "$GRADLE_URL" -o "$GRADLE_ZIP"
  else
    wget "$GRADLE_URL" -O "$GRADLE_ZIP"
  fi
  unzip -q -o "$GRADLE_ZIP" -d "$BASE_DIR/.gradle/wrapper/dists/gradle-$GRADLE_VERSION-bin"
fi

exec "$GRADLE_BIN" "$@"
